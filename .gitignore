# Secrets and local env overrides — never commit
.env
.env.*
infra/docker/*.env
# But always commit example templates
!.env.example
!**/.env.example

# Go build artifacts
bin/
*.exe

# sqlc generated output — regenerate with `sqlc generate`
**/internal/repository/db/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
