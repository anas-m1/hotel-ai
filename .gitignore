# Secrets and local env overrides — never commit
.env
.env.*
infra/docker/*.env
# But always commit example templates
!.env.example
!**/.env.example

# Go build artifacts
bin/
*.exe

# sqlc output is versioned; regenerate with sqlc v1.31.1.

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Local tooling caches and generated eval runs
.cache/
evals/**/runs/

# Personal editor/agent state and cloud state
.claude/
.mcp.json
.vscode/
.idea/
.DS_Store
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
*.pem
*.key
