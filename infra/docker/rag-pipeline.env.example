# RAG Pipeline — copy to rag-pipeline.env and fill in values

PORT=8091
LOG_LEVEL=INFO

# Qdrant — use Docker service name as host
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY="" # gitleaks:allow -- empty optional development setting

HOTELS_COLLECTION=hotels

# hotel-inventory — use Docker service name as host
HOTEL_INVENTORY_URL=http://hotel-inventory:8080

DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions

PREFETCH_LIMIT=50
SEARCH_LIMIT=10
