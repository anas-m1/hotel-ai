# Copy to telegram-bot.env (ignored by Git). Never put the bot token in chat,
# source files, command-line arguments, screenshots, or logs.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to chat and approve bookings.
# Start the bot, send /whoami in a private chat, add your ID here, then restart.
TELEGRAM_ALLOWED_USER_IDS=

BOOKING_ASSISTANT_URL=http://booking-assistant:8092
