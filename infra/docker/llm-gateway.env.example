# LLM Gateway — copy to llm-gateway.env and fill in at least one provider key

# Server
PORT=8090
LOG_LEVEL=INFO

# LLM provider keys — set whichever providers you want to route to
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# For AWS Bedrock instead of an API key:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Default model when the caller omits the model field
DEFAULT_MODEL=claude-sonnet-4-6

# Cost log path inside the container (backed by the llm_usage Docker volume)
COST_LOG_PATH=/tmp/llm-usage.jsonl

# Path to prompt YAML files, relative to the container working directory
PROMPTS_DIR=prompts

# Langfuse tracing — leave empty to disable
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
