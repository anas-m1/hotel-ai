PORT=8093
LLM_GATEWAY_URL=http://llm-gateway:8090
RAG_PIPELINE_URL=http://rag-pipeline:8091
BOOKING_OPS_URL=http://booking-ops:8081
HOTEL_INVENTORY_URL=http://hotel-inventory:8080

SUPERVISOR_MODEL=claude-sonnet-4-6
WORKER_MODEL=claude-haiku-4-5-20251001
AGENT_TEMPERATURE=0.1

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=multi-agent
KAFKA_BOOKING_TOPIC=hotel.booking.events
KAFKA_AGENT_TOPIC=hotel.agent.events

# Redis — persistent agent memory
REDIS_URL=redis://redis:6379

# Langfuse tracing — leave empty to disable
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
