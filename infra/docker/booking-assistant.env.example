# Booking Assistant — LangGraph ReAct agent
# Copy to booking-assistant.env

# Server
PORT=8092
LOG_LEVEL=INFO

# Internal service URLs (Docker Compose service names)
LLM_GATEWAY_URL=http://llm-gateway:8090
RAG_PIPELINE_URL=http://rag-pipeline:8091
BOOKING_OPS_URL=http://booking-ops:8081
HOTEL_INVENTORY_URL=http://hotel-inventory:8080

# Model routed through the LLM gateway
# Groq: groq/llama-3.3-70b-versatile  |  Anthropic: claude-sonnet-4-6
AGENT_MODEL=groq/llama-3.3-70b-versatile
AGENT_TEMPERATURE=0.3

# Redis — persistent agent memory (cross-session checkpoints)
REDIS_URL=redis://redis:6379

# Langfuse tracing — leave empty to disable
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
