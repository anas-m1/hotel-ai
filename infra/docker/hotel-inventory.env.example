# Copy this file to hotel-inventory.env and fill in values.
# hotel-inventory.env is gitignored — never commit actual secrets.

# Postgres connection — uses Docker service name as host when running in docker-compose.
# For running the service directly (outside Docker): change host to localhost.
DATABASE_URL=postgres://hotel:hotel@postgres:5432/hotel_inventory?sslmode=disable

PORT=8080

# Pagination — defaults used if these are not set.
PAGINATION_DEFAULT=20
PAGINATION_MAX=100
