# LLM Gateway — copy to .env and fill in at least one provider key

# Server
PORT=8090
LOG_LEVEL=INFO

# LLM provider keys — set whichever providers you want to use
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# For AWS Bedrock: set these instead of an API key
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Routing defaults
DEFAULT_MODEL=claude-sonnet-4-6

# Cost log (JSONL, one entry per request)
COST_LOG_PATH=/tmp/llm-usage.jsonl

# Path to prompt YAML files (relative to the working directory inside the container)
PROMPTS_DIR=prompts
