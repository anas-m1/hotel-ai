# RAG Pipeline — copy to .env and adjust for your environment

PORT=8091
LOG_LEVEL=INFO

# Qdrant connection
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # leave empty for local unauthenticated Qdrant

# Collection name in Qdrant
HOTELS_COLLECTION=hotels

# hotel-inventory service (source of hotel data for indexing)
HOTEL_INVENTORY_URL=http://localhost:8080

# Embedding models (fastembed — downloaded locally, no API key needed)
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions

# Search tuning
PREFETCH_LIMIT=50
SEARCH_LIMIT=10
